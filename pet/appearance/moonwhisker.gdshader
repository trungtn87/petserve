shader_type spatial;
render_mode diffuse_burley, specular_schlick_ggx;
uniform vec4 fur_color : source_color;
uniform vec4 accent_color : source_color;
uniform vec4 chest_color : source_color;
uniform vec4 inner_ear_color : source_color;
uniform vec4 iris_color : source_color;
uniform vec4 iris_lower_color : source_color;
uniform vec4 rune_color : source_color;
uniform float rune_energy = 0.8;
float oval(vec2 p, vec2 center, vec2 size) { return length((p-center)/size); }
void fragment() {
	vec3 p = vec3(UV, UV2.x);
	float front = smoothstep(0.68, 0.88, p.z);
	float streak = sin(p.x*95.0 + sin(p.y*27.0+p.z*13.0)*2.0 + p.y*32.0);
	float patches = 0.5+0.5*sin(p.y*13.0+p.z*9.0+sin(p.x*15.0));
	vec3 fur = mix(fur_color.rgb, accent_color.rgb, patches*0.32);
	fur *= 0.99+0.01*streak;
	float chest = (1.0-smoothstep(0.8,1.1,oval(p.xy,vec2(0.0,0.48),vec2(0.26,0.22))))*smoothstep(0.35,0.7,p.z);
	fur = mix(fur,chest_color.rgb,chest*0.65);
	float ears = (1.0-smoothstep(0.65,1.0,oval(vec2(abs(p.x),p.y),vec2(0.39,1.43),vec2(0.11,0.19))))*smoothstep(0.25,0.6,p.z);
	fur = mix(fur,inner_ear_color.rgb,ears*0.85);
	vec2 eye = vec2(abs(p.x),p.y);
	float eye_d = oval(eye,vec2(0.237,1.075),vec2(0.142,0.153));
	float eye_mask = (1.0-smoothstep(0.91,1.03,eye_d))*front;
	float iris_d = oval(eye,vec2(0.225,1.072),vec2(0.128,0.143));
	vec3 iris = mix(iris_lower_color.rgb,iris_color.rgb,smoothstep(0.96,1.16,p.y));
	iris *= 0.8+0.2*sin(atan(p.y-1.072,abs(p.x)-0.225)*39.0);
	vec3 eye_col = mix(vec3(0.28,0.34,0.43),iris,1.0-smoothstep(0.92,1.0,iris_d));
	float pupil = 1.0-smoothstep(0.9,1.0,oval(eye,vec2(0.225,1.085),vec2(0.067,0.102)));
	eye_col = mix(eye_col,vec3(0.009,0.006,0.023),pupil);
	float shine = 1.0-smoothstep(0.7,1.0,oval(eye,vec2(0.202,1.127),vec2(0.025,0.029)));
	eye_col = mix(eye_col,vec3(0.92,0.97,1.0),shine);
	fur = mix(fur,eye_col,eye_mask);
	float nose = (1.0-smoothstep(0.7,1.0,oval(p.xy,vec2(0.0,0.867),vec2(0.066,0.037))))*front;
	fur = mix(fur,vec3(0.14,0.065,0.12),nose);
	vec2 moon = (p.xy-vec2(0.0,1.348))/vec2(0.060,0.074);
	float rune = (1.0-smoothstep(0.93,1.0,length(moon)))*smoothstep(0.78,0.86,length(moon-vec2(0.44,0.22)))*front;
	ALBEDO = mix(fur,rune_color.rgb,rune);
	ROUGHNESS = mix(0.84,0.2,eye_mask);
	SPECULAR = mix(0.28,0.65,eye_mask);
	EMISSION = rune_color.rgb*rune*rune_energy + eye_col*eye_mask*0.12;
}
